@using CTD_FINAL.Entities
@model CTD_FINAL.Entities.MisctJob?
@{
    ViewData["Title"] = Model is null ? "Job — MISCT (New)" : $"Job — MISCT ({Model.JobNo})";
    string jobNumber = (string)ViewBag.NextJobNumber;
    string D(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";
    string today = DateTime.Today.ToString("yyyy-MM-dd");

    var parties = (List<Party>)ViewBag.Parties;
    var subAgents = (List<SubAgent>)ViewBag.SubAgents;
    var customsHouses = (List<CustomsHouse>)ViewBag.CustomsHouses;
    var borderPoints = (List<BorderPoint>)ViewBag.BorderPoints;
    var commodities = (List<Commodity>)ViewBag.Commodities;

    // Client-side lookup data for the Party Code cascade (Party Name / Address / Sub-Agent
    // auto-fill) — same convention as Job ISNE's own embedded-JSON cascade (see wwwroot/js/job-misct.js).
    var partyLookup = parties.Where(p => !string.IsNullOrEmpty(p.PartyCode)).Select(p => new
    {
        code = p.PartyCode,
        name = p.Name,
        subAgentCode = p.SubAgentCode,
        branches = p.Branches.OrderByDescending(b => b.IsPrimary).Select(b => new
        {
            id = b.Id,
            label = b.BranchName,
            address = string.Join(", ", new[] { b.AddressLine1, b.AddressLine2, b.City, b.State, b.PinCode, b.Country }.Where(s => !string.IsNullOrWhiteSpace(s)))
        }).ToList()
    }).ToList();
    var subAgentLookup = subAgents.Select(s => new { code = s.SubAgentCode, name = s.Name }).ToList();

    var containerInit = Model != null && Model.Containers.Any()
        ? Model.Containers.Select(c => new
        {
            containerNo = c.ContainerNo,
            sealNo = c.SealNo,
            containerSize = c.ContainerSize,
            weight = c.Weight,
            cifValue = c.CifValue
        })
        : new[] { new
        {
            containerNo = (string?)"",
            sealNo = (string?)"",
            containerSize = "20ft",
            weight = (decimal?)null,
            cifValue = (decimal?)null
        } };
}

<div class="erp-form-header">
    <div class="erp-form-title">
        <div style="width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--amber-500),var(--amber-600));display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#1a1305" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
        <div>
            <h2>JOB — MISCT</h2>
            <div style="font-size:11.5px;color:#aab4cc;margin-top:2px;">Miscellaneous Cargo Transit &nbsp;·&nbsp; Press F9 to Save</div>
        </div>
        <span>MISCT Entry</span>
    </div>
    <div class="erp-form-actions">
        <button class="btn btn-outline btn-sm" id="misctNewBtn" style="background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);color:#e6e9f2;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg> New
        </button>
        <button class="btn btn-amber btn-sm" id="misctSaveBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> @(Model is null ? "Save (F9)" : "Update (F9)")
        </button>
        <button class="btn btn-danger btn-sm" id="misctDeleteBtn" @(Model is null ? "disabled" : "")>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg> Delete
        </button>
        <select id="misctForwardingProvider" style="height:32px;border-radius:8px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);color:#e6e9f2;" @(Model is null ? "disabled" : "")>
            <option value="concor">CONCOR</option>
            <option value="pristine">Pristine</option>
            <option value="htpl">HTPL</option>
        </select>
        <button class="btn btn-outline btn-sm" id="misctForwardingNoteBtn" title="Print Forwarding Note" style="background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);color:#e6e9f2;" @(Model is null ? "disabled" : "")>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg> Forwarding Note
        </button>
        <button class="btn btn-outline btn-sm" id="misctDeclarationBtn" title="Print Declaration of Transshipment" style="background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);color:#e6e9f2;" @(Model is null ? "disabled" : "")>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg> Declaration of Transshipment
        </button>
        <button class="btn btn-outline btn-sm" id="misctTpPermitBtn" title="Print Transhipment Permit" style="background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);color:#e6e9f2;" @(Model is null ? "disabled" : "")>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg> Transhipment Permit
        </button>
        <button class="btn btn-ghost btn-sm" id="misctCancelBtn" style="color:#aab4cc;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Cancel
        </button>
    </div>
</div>

<form id="misctForm" data-record-id="@(Model?.Id ?? 0)">
<div class="erp-form-body">

    <!-- ============ SECTION A: JOB INFORMATION ============ -->
    <div class="erp-section">
        <div class="erp-section-head">
            <div class="section-letter">A</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            Job Information
        </div>
        <div class="erp-section-body">
            <div class="form-grid cols-4">
                <div class="field">
                    <label>Job No.</label>
                    <div class="field-static" id="misct_jobNo">@jobNumber</div>
                </div>
                <div class="field">
                    <label>Job Date</label>
                    <input type="date" id="misct_jobDate" value="@(Model is null ? today : D(Model.JobDate))">
                </div>
                <div class="field span-2" style="position:relative;visibility:hidden">
                    <label>Load Existing Job <span style="font-weight:400;color:var(--ink-400);">(search by Job No.)</span></label>
                    <input type="text" id="misct_loadJobNo" placeholder="Type a Job No. to find and open it" autocomplete="off">
                    <div id="misct_loadJobSuggestions" class="autocomplete-list" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ SECTION B: PARTY & SUB AGENT ============ -->
    <div class="erp-section">
        <div class="erp-section-head">
            <div class="section-letter">B</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Party &amp; Sub Agent
        </div>
        <div class="erp-section-body">
            <div class="form-grid cols-4">
                <div class="field">
                    <label>Party Code</label>
                    <select id="misct_partyCode">
                        <option value="">-- Select Party --</option>
                        @foreach (var p in parties.Where(p => !string.IsNullOrEmpty(p.PartyCode)))
                        {
                            <option value="@p.PartyCode" selected="@(Model != null && Model.PartyCode == p.PartyCode)">@p.PartyCode — @p.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Party Name</label>
                    <input type="text" id="misct_partyName" placeholder="Importer / Consignee Name" value="@Model?.PartyName">
                </div>
                <div class="field" id="misct_branchField" style="display:none;">
                    <label>Branch <span style="font-weight:400;color:var(--ink-400);">(multiple on file)</span></label>
                    <select id="misct_branchSelect"></select>
                </div>
                <div class="field span-2">
                    <label>Address</label>
                    <textarea id="misct_address" placeholder="Full address of the party" style="min-height:60px;">@Model?.Address</textarea>
                </div>
                <div class="field">
                    <label>Sub Agent Code</label>
                    <input type="text" id="misct_subAgentCode" placeholder="e.g. BL000" value="@Model?.SubAgentCode">
                </div>
                <div class="field">
                    <label>Sub Agent Name</label>
                    <input type="text" id="misct_subAgentName" placeholder="Sub Agent Name" value="@Model?.SubAgentName">
                </div>
            </div>
        </div>
    </div>

    <script id="misctPartyLookupData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(partyLookup))</script>
    <script id="misctSubAgentLookupData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(subAgentLookup))</script>

    <!-- ============ SECTION C: VESSEL & MOVEMENT ============ -->
    <div class="erp-section">
        <div class="erp-section-head">
            <div class="section-letter">C</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7"/></svg>
            Vessel &amp; Movement
        </div>
        <div class="erp-section-body">
            <div class="form-grid cols-4">
                <div class="field"><label>Vessel Name</label><input type="text" id="misct_vesselName" placeholder="e.g. SOL PIONEER" maxlength="30" value="@Model?.VesselName"></div>
                <div class="field"><label>Voyage No.</label><input type="text" id="misct_voyageNo" placeholder="e.g. 2607S" value="@Model?.VoyageNo"></div>
                <div class="field span-2"><label>Country of CGN</label><input type="text" id="misct_countryCgn" placeholder="e.g. PERAWANG, INDONESIA" value="@Model?.CountryCgn"></div>
                <div class="field"><label>ROT No.</label><input type="text" id="misct_rotNo" placeholder="e.g. 1195421/26" value="@Model?.RotNo"></div>
                <div class="field"><label>ROT Date</label><input type="date" id="misct_rotDate" value="@D(Model?.RotDate)"></div>
                <div class="field"><label>Line No.</label><input type="text" id="misct_lineNo" placeholder="e.g. 32" value="@Model?.LineNo"></div>
                <div class="field"></div>
                <div class="field"><label>M/BL No.</label><input type="text" id="misct_mblNo" placeholder="e.g. BLPLPWG2600166" value="@Model?.MblNo"></div>
                <div class="field"><label>M/BL Date</label><input type="date" id="misct_mblDate" value="@D(Model?.MblDate)"></div>
            </div>
        </div>
    </div>

    <!-- ============ SECTION D: CUSTOMS & ROUTE ============ -->
    <div class="erp-section">
        <div class="erp-section-head">
            <div class="section-letter">D</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
            Customs &amp; Route
        </div>
        <div class="erp-section-body">
            <div class="form-grid cols-4">
                <div class="field span-2">
                    <label>Customs Stn of Exit</label>
                    <select id="misct_customsStationExit">
                        <option value="">-- Select Customs House --</option>
                        @foreach (var c in customsHouses)
                        {
                            <option value="@c.Id" selected="@(Model != null && Model.CustomsStationExitId == c.Id)">@c.Code — @c.Name</option>
                        }
                    </select>
                </div>
                <div class="field span-2">
                    <label>Port of Entry in Nepal</label>
                    <select id="misct_portOfEntryNepal">
                        <option value="">-- Select Border Point --</option>
                        @foreach (var b in borderPoints)
                        {
                            <option value="@b.Id" selected="@(Model != null && Model.PortOfEntryNepalId == b.Id)">@b.Name@(string.IsNullOrEmpty(b.State) ? "" : $" ({b.State})")</option>
                        }
                    </select>
                </div>
                <div class="field span-2"><label>Port of Entry in India</label><input type="text" id="misct_portOfEntryIndia" placeholder="e.g. KOLKATA" value="@Model?.PortOfEntryIndia"></div>
                <div class="field span-2"><label>Bond No.</label><input type="text" id="misct_bondNo" placeholder="e.g. 2002332973" value="@Model?.BondNo"></div>
            </div>
        </div>
    </div>

    <!-- ============ SECTION E: CONTAINER / CARGO INFORMATION ============ -->
    <div class="erp-section">
        <div class="erp-section-head">
            <div class="section-letter">E</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><path d="M1 10h22"/></svg>
            Container / Cargo Information
        </div>
        <div class="erp-section-body">
            <div class="split-panel" style="margin-bottom:18px;">
                <div class="split-panel-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><path d="M1 10h22"/></svg>
                    Container Size
                    <span style="font-weight:500;color:var(--ink-500);font-size:11.5px;">(auto-tallied from the grid below — editable)</span>
                </div>
                <div class="form-grid cols-3" style="gap:14px;">
                    <div class="field"><label>20 FT</label><input type="number" id="misct_container20Qty" min="0" step="1" value="@(Model?.Container20Qty ?? 0)"></div>
                    <div class="field"><label>40 FT</label><input type="number" id="misct_container40Qty" min="0" step="1" value="@(Model?.Container40Qty ?? 0)"></div>
                    <div class="field"><label>LCL</label><input type="number" id="misct_lclQty" min="0" step="1" value="@(Model?.LclQty ?? 0)"></div>
                </div>
            </div>
            <div class="form-grid cols-4">
                <div class="field span-2" style="position:relative;">
                    <label>Custom Code</label>
                    <input type="text" id="misct_customCode" list="misct_customCodeList" placeholder="e.g. HSITC/48025500" value="@Model?.CustomCode">
                    <datalist id="misct_customCodeList">
                        @foreach (var c in commodities)
                        {
                            <option value="@c.HsCode">@c.Name</option>
                        }
                    </datalist>
                </div>
                <div class="field"><label>No. of Package</label><input type="number" id="misct_noOfPackage" min="0" step="1" value="@(Model?.NoOfPackage ?? 0)"></div>
                <div class="field"><label>Gross Weight (Kgs)</label><input type="number" id="misct_grossWeight" placeholder="0.000" min="0" step="0.001" value="@Model?.GrossWeight"></div>
                <div class="field span-2">
                    <label>Unit <span style="font-weight:400;color:var(--ink-400);">(auto-suggested — editable)</span></label>
                    <input type="text" id="misct_unit" placeholder="e.g. 2X20' CONT. STC 82 PLT" value="@Model?.Unit">
                </div>
                <div class="field"><label>Invoice No.</label><input type="text" id="misct_invoiceNo" placeholder="e.g. 2160205998" value="@Model?.InvoiceNo"></div>
                <div class="field"><label>Invoice Date</label><input type="date" id="misct_invoiceDate" value="@D(Model?.InvoiceDate)"></div>
                <div class="field span-4"><label>Description</label><textarea id="misct_description" placeholder="e.g. WOODFREE OFFSET PAPER THE PRICE" style="min-height:80px;">@Model?.Description</textarea></div>
            </div>
        </div>
    </div>

    <!-- ============ SECTION F: CONTAINER DETAILS ============ -->
    <div class="erp-section">
        <div class="erp-section-head">
            <div class="section-letter">F</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><path d="M1 10h22"/></svg>
            Container Details
        </div>
        <div class="erp-section-body">
            <div class="table-scroll">
                <table class="mini-table" id="misctContainerTable">
                    <thead>
                        <tr>
                            <th style="width:28px;"><input type="checkbox" id="misctSelectAllRows" style="width:16px;height:16px;padding:0;accent-color:var(--amber-500);"></th>
                            <th style="width:34px;">S.No</th>
                            <th style="min-width:150px;">Container No.</th>
                            <th style="min-width:110px;">Seal No.</th>
                            <th style="min-width:90px;">Size</th>
                            <th style="min-width:110px;">Weight</th>
                            <th style="min-width:120px;">CIF Value</th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody id="misctContainerRowsBody"></tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2"></td>
                            <td style="font-weight:700;">Total (<span id="misct_totalCount">0</span>)</td>
                            <td></td>
                            <td></td>
                            <td style="font-weight:700;" id="misct_totalWeight">0.000</td>
                            <td style="font-weight:700;" id="misct_totalCifValue">0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="flex-between" style="margin-top:12px;">
                <button type="button" class="btn btn-outline btn-xs" id="misctAddContainerBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                    Add Container
                </button>
                <button type="button" class="btn btn-danger btn-xs" id="misctRemoveSelectedBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m5 0V4a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v2"/></svg>
                    Remove Selected
                </button>
            </div>
        </div>
    </div>
    <script id="misctContainerDataInit" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(containerInit))</script>

    <!-- ============ SECTION G: AUTHORISED CARRIER ============ -->
    <div class="erp-section">
        <div class="erp-section-head">
            <div class="section-letter">G</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7"/></svg>
            Authorised Carrier
        </div>
        <div class="erp-section-body">
            <div class="form-grid cols-4">
                <div class="field span-2"><label>Carrier Name</label><input type="text" id="misct_carrierName" placeholder="e.g. TRANSWORLD GLOBAL LOGISTICS SOLUTIONS (I) PVT. LTD" value="@Model?.CarrierName"></div>
                <div class="field span-2"><label>Carrier Address</label><input type="text" id="misct_carrierAddress" placeholder="e.g. 32, CHOWRINGHEE ROAD, KOLKATA-700071" value="@Model?.CarrierAddress"></div>
                <div class="field"><label>Carrier GSTIN</label><input type="text" id="misct_carrierGstin" placeholder="e.g. 19AAFCT5406M1Z" value="@Model?.CarrierGstin"></div>
                <div class="field"><label>Quantity</label><input type="number" id="misct_quantity" min="0" step="1" value="@Model?.Quantity"></div>
                <div class="field"><label>Quantity Unit</label><input type="text" id="misct_quantityUnit" placeholder="e.g. PLT" value="@Model?.QuantityUnit"></div>
            </div>
        </div>
    </div>

    <!-- Form Footer Buttons -->
    <div style="display:flex;gap:12px;justify-content:flex-end;padding-top:8px;">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('misctCancelBtn').click()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Cancel
        </button>
        <button type="button" class="btn btn-danger" onclick="document.getElementById('misctDeleteBtn').click()" @(Model is null ? "disabled" : "")>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
            Delete
        </button>
        <button type="button" class="btn btn-amber" onclick="document.getElementById('misctSaveBtn').click()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/></svg>
            @(Model is null ? "Save Job (F9)" : "Update Job (F9)")
        </button>
    </div>

</div>
</form>

@section Scripts {
    <script src="~/js/job-misct.js" asp-append-version="true"></script>
}
