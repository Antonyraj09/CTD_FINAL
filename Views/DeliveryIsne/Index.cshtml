@{
    ViewData["Title"] = "Delivery — ISNE";
}
<div class="section-head">
    <div>
        <h2>Delivery — ISNE</h2>
        <p>Search, create, and manage every Delivery ISNE record</p>
    </div>
    <div class="section-actions">
        <a class="btn btn-amber btn-sm" asp-controller="DeliveryIsne" asp-action="Entry">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
            New Delivery
        </a>
    </div>
</div>

<div class="panel" style="margin-bottom:18px;">
    <div class="panel-body">
        <div class="form-grid cols-4">
            <div class="field"><label>Serial No.</label><input type="text" id="dlv_serialNo" placeholder="e.g. 50334"></div>
            <div class="field"><label>Job No.</label><input type="text" id="dlv_jobNo" placeholder="ISNE/0001/2026"></div>
            <div class="field"><label>Delivery Date From</label><input type="date" id="dlv_dateFrom"></div>
            <div class="field"><label>Delivery Date To</label><input type="date" id="dlv_dateTo"></div>
            <div class="field"><label>Customer</label><input type="text" id="dlv_customer" placeholder="Customer name"></div>
            <div class="field"><label>Transporter</label><input type="text" id="dlv_transporter" placeholder="Transporter name"></div>
            <div class="field" style="justify-content:flex-end;flex-direction:row;align-items:flex-end;gap:8px;">
                <button class="btn btn-primary btn-block" id="dlv_searchBtn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>Search</button>
                <button class="btn btn-ghost" id="dlv_clearBtn" title="Clear filters"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m5 0V4a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v2"/></svg></button>
                <button class="btn btn-ghost" id="dlv_refreshBtn" title="Refresh"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg></button>
            </div>
        </div>
    </div>
</div>

<div class="panel">
    <div class="table-toolbar">
        <div class="table-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" id="dlv_quickSearch" placeholder="Quick filter…">
        </div>
        <div class="table-filters">
            <span class="tag-chip" id="dlv_resultCount">0 deliveries</span>
            <div class="export-bar">
                <button class="btn btn-outline btn-xs" data-export="excel" data-table="#deliveryTable" data-title="Delivery ISNE"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>Export to Excel</button>
                <button class="btn btn-outline btn-xs" data-action="printTable" data-table="#deliveryTable" data-title="Delivery ISNE"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>Print</button>
            </div>
        </div>
    </div>
    <div class="table-scroll" id="deliveryTableContainer">
        <!-- loaded via AJAX -->
    </div>
</div>

@section Scripts {
    <script src="~/js/delivery-isne-list.js" asp-append-version="true"></script>
}
