@using CTD_FINAL.DTOs
@using CTD_FINAL.Entities
@model PagedResult<DeliveryIsne>
@{
    var sortKey = ViewData["SortKey"] as string ?? "deliveryDate";
    var sortDir = ViewData["SortDir"] as string ?? "desc";
    string SortIco(string key) => sortKey == key ? (sortDir == "asc" ? "↑" : "↓") : "↕";
}
<table class="data-table" id="deliveryTable">
    <thead>
        <tr>
            <th class="sortable" data-sort="serialNo">Serial No. <span class="sort-ico">@SortIco("serialNo")</span></th>
            <th class="sortable" data-sort="deliveryDate">Delivery Date <span class="sort-ico">@SortIco("deliveryDate")</span></th>
            <th class="sortable" data-sort="jobNo">Job No. <span class="sort-ico">@SortIco("jobNo")</span></th>
            <th>Customer</th>
            <th>Transporter</th>
            <th>Container No.</th>
            <th>Package</th>
            <th class="no-print">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="8" class="table-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                <div>No deliveries match your search criteria</div>
            </td></tr>
        }
        else
        {
            foreach (var d in Model.Items)
            {
                <tr data-delivery-id="@d.Id">
                    <td class="cell-strong job-code">@d.SerialNo</td>
                    <td>@d.DeliveryDate.ToString("d MMM yyyy")</td>
                    <td>@d.JobNo</td>
                    <td>@(d.CustomerName ?? "—")</td>
                    <td>@(d.TransporterName ?? "—")</td>
                    <td>@(d.ContainerNo ?? "—")</td>
                    <td>@(d.Package.HasValue ? d.Package.Value.ToString("N3") : "—")</td>
                    <td class="no-print">
                        <div class="row-actions">
                            <a class="iconbtn-table" asp-controller="DeliveryIsne" asp-action="Entry" asp-route-id="@d.Id" asp-route-view="true" title="View"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg></a>
                            <a class="iconbtn-table" asp-controller="DeliveryIsne" asp-action="Entry" asp-route-id="@d.Id" title="Edit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></a>
                            <a class="iconbtn-table" href="/DeliveryIsne/Print/@d.Id" target="_blank" title="Print"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg></a>
                            <button type="button" class="iconbtn-table dlv-delete-btn" data-id="@d.Id" data-serial="@d.SerialNo" title="Delete"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg></button>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<div class="table-foot">
    <span class="text-muted" id="dlv_paginationInfo">
        @(Model.TotalCount > 0 ? $"Showing {((Model.Page - 1) * Model.PageSize) + 1}–{Math.Min(Model.Page * Model.PageSize, Model.TotalCount)} of {Model.TotalCount}" : "Showing 0–0 of 0")
    </span>
    <div class="pagination" id="dlv_pagination">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <button type="button" class="page-btn @(p == Model.Page ? "active" : "")" data-page="@p">@p</button>
        }
    </div>
</div>
