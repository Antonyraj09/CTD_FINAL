@using CTD_FINAL.Enums
@using CTD_FINAL.Models.Install
@model List<ClientListItem>
@{
    Layout = "_SetupLayout";
    ViewData["Title"] = "Installed Clients";
    string D(DateTime? d) => d?.ToString("d MMM yyyy") ?? "—";

    // Enums serialize as their string name here, not the default numeric value — the detail
    // modal's JS reads these directly for display (e.g. "Active", not "0").
    var jsonOptions = new System.Text.Json.JsonSerializerOptions();
    jsonOptions.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter());
}
@{ var pendingCount = (int)(ViewBag.PendingCount ?? 0); }
<div class="section-head">
    <div>
        <h2>Installed Clients</h2>
        <p>Double-click a row to view and edit its details.</p>
        @if (pendingCount > 0)
        {
            <p style="margin-top:6px;">
                <a href="/Install" style="color:#c0392b;font-weight:600;">
                    @(pendingCount == 1 ? "1 installation" : $"{pendingCount} installations") didn't complete — resume or discard it →
                </a>
            </p>
        }
    </div>
    <div class="section-actions">
        <a class="btn btn-amber btn-sm" asp-controller="Install" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
            Install New Client
        </a>
    </div>
</div>

<div class="panel" id="clientsRoot" data-setup-key="@ViewBag.SetupKey">
    <div class="table-scroll">
        <table class="data-table" id="clientsTable">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>License No.</th>
                    <th>License Type</th>
                    <th>Status</th>
                    <th>Database</th>
                    <th>Last Attempt</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="table-empty"><div>No clients installed yet.</div></td></tr>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        <tr data-id="@c.Id">
                            <td>
                                <div class="cell-strong">@c.CompanyName</div>
                                <div class="text-muted" style="font-size:11px;">@c.CompanyCode</div>
                            </td>
                            <td class="cell-strong">@(c.LicenseNumber ?? "—")</td>
                            <td>@c.LicenseType</td>
                            <td><span class="badge badge-approved">@c.LicenseStatus</span></td>
                            <td>
                                <div>@(c.DatabaseName ?? "—")</div>
                                <div class="text-muted" style="font-size:11px;">@(c.ServerName ?? "")</div>
                            </td>
                            <td>
                                <div>@D(c.InstallationDate)</div>
                                <div class="text-muted" style="font-size:11px;">@(c.InstalledBy ?? "—")</div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script id="clientsDetailData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, jsonOptions))</script>

@section Scripts {
    <script src="~/js/install-clients.js" asp-append-version="true"></script>
}

<style>
    #clientsTable tbody tr { cursor: pointer; }
    #clientsTable tbody tr:hover { background: #f5f7fb; }
</style>
