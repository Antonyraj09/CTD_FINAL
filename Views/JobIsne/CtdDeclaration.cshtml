@using System.Globalization
@using CTD_FINAL.Entities
@model JobIsne
@{
    Layout = null;
    var agent = ViewBag.Agent as SubAgent;
    var inr = CultureInfo.GetCultureInfo("en-IN");

    string D(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "";
    string V(object? v) => v?.ToString() ?? "";
    string Rs(decimal? v) => v.HasValue ? v.Value.ToString("N2", inr) : "";

    // "B/L No. & Date" has one box in the reference form; JobIsne tracks both a Master
    // and a House B/L. The reference CTD Submission checklist format (a separate,
    // field-verified reference document) shows the Master B/L number in this exact slot,
    // so it's preferred here, falling back to the House B/L only if no Master B/L exists.
    var blNo = !string.IsNullOrWhiteSpace(Model.MblNo) ? Model.MblNo : Model.HblNo;
    var blDate = !string.IsNullOrWhiteSpace(Model.MblNo) ? Model.MblDate : Model.HblDate;

    // Default forwarding agent letterhead — every job printed without its own matching
    // Sub-Agent master record (no SubAgentCode set, or the code doesn't resolve to one)
    // used to print this whole header blank. Falls back to this agency's own details
    // (the reference form's own letterhead) rather than leaving it empty.
    const string DefaultAgentName = "EASTERN CLEARING & FORWARDING AGENCY PVT. LTD.";
    const string DefaultAgentLicenseNo = "E-18";
    const string DefaultAgentAddress = "501 'MANGALAM' 24, HEMANTA BASU SARANI, KOLKATA-700001";
    const string DefaultAgentPhone = "2243-5348";
    const string DefaultAgentGstin = "19AAACE5876H1ZB";

    // CHA identity on this form is always the logged-in CHA/forwarding company itself —
    // never the job's Party or SubAgent, which is a different party to the shipment. Name
    // and Address come from the tenant's own Company Profile (Settings screen), which is
    // exactly what AppSettingsEntity.CompanyName/CompanyAddress exist for.
    var settings = ViewBag.CompanySettings as AppSettingsEntity;
    var agentName = settings?.CompanyName;
    if (string.IsNullOrWhiteSpace(agentName)) agentName = DefaultAgentName;

    var agentLicenseNo = agent?.LicenseNo;
    if (string.IsNullOrWhiteSpace(agentLicenseNo)) agentLicenseNo = DefaultAgentLicenseNo;

    var agentPhone = agent?.Phone;
    if (string.IsNullOrWhiteSpace(agentPhone)) agentPhone = DefaultAgentPhone;

    var agentGstin = agent?.GstinNo;
    if (string.IsNullOrWhiteSpace(agentGstin)) agentGstin = DefaultAgentGstin;

    var agentAddress = settings?.CompanyAddress;
    if (string.IsNullOrWhiteSpace(agentAddress)) agentAddress = DefaultAgentAddress;

    // Ship's Name prefers the transshipment vessel/voyage (the one actually carrying the
    // container into the relevant Indian port for this transit) over the main ocean vessel,
    // falling back to the main vessel/voyage when there's no transshipment leg recorded.
    var shipName = !string.IsNullOrWhiteSpace(Model.TsVessel) ? Model.TsVessel : Model.VesselName;
    var shipVoyage = !string.IsNullOrWhiteSpace(Model.TsVessel) ? Model.TsVoyage : Model.VoyageNo;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Customs Transit Declaration - @Model.JobNumber</title>
    <style>
        /* Page size, margins and every column/row dimension below are taken directly
           from the reference form's own Word document (pgSz/pgMar/gridCol/trHeight in
           word/document.xml) so the printed sheet matches the reference 1:1 — this is a
           customs-submission form, not a free-flowing report. */
        @@page { size: A4; margin: 3.88mm 9.98mm 4.94mm 2.49mm; }
        body { font-family: Arial, Helvetica, sans-serif; color: #10172a; font-size: 10pt; line-height: 1.1; margin: 0; }
        table { border-collapse: collapse; table-layout: fixed; width: 193.26mm; margin-left: 2.5mm; }
        td, th { border: 1px solid #10172a; padding: 1px 4px; vertical-align: top; word-wrap: break-word; box-sizing: border-box; }
        .outer { border: 1.6px solid #10172a; }
        /* A long agent name/address (real CHA company names run long) can push a row past
           its reference-derived floor height; without this, Chrome's print pagination will
           split the row's content mid-cell across two pages instead of moving it as a whole. */
        tr { break-inside: avoid; page-break-inside: avoid; }

        /* Uniform 10pt everywhere (inherited from body, no per-class overrides) — bold is
           reserved strictly for database-fetched values, never for static labels/titles. */
        .agent-cha { float: right; white-space: nowrap; margin-left: 4px; }
        .agent-cha b { font-weight: 700; }
        .agent-name { font-weight: 700; font-style: italic; }
        .agent-addr { margin-top: 1px; clear: both; }
        .agent-phone-gst { margin-top: 1px; }
        .agent-phone-gst b { font-weight: 700; }

        .title-cell { text-align: center; padding: 0; }
        .copytype { text-align: right; border-bottom: 1px solid #10172a; padding: 1px 6px; }
        .title-body { padding: 2px 7px 1px; }
        .formtitle { letter-spacing: .02em; }
        .subtitle-row { display: block; position: relative; }
        .subtitle-row .iccd { position: absolute; right: 0; }
        .jobno { margin-top: 3px; }

        .cell-lbl { color: #333; }
        .cell-val { font-weight: 700; margin-top: 1px; }
        .verify-text { margin: 2px 0 4px; }
        .intransit { margin-top: 4px; }
        .center { text-align: center; }

        .cargo-grid th { background: #f3f4f8; text-align: left; }
        .wv-col { height: 104.97mm; }
        .wv-second { margin-top: 25mm; }
        .wv-lbl { color: #333; }
        .wv-val { font-weight: 700; }
        .container-block { margin-bottom: 5px; }
        .container-block b { display: block; }

        .decl-cell b { font-weight: 700; }
        .sign-block { margin-top: 6px; }
        .sign-date { position: absolute; left: 4px; right: 4px; bottom: 4px; }

        .footer { margin: 0 0 0 2.5mm; font-size: 7pt; line-height: 1; color: #888; text-align: right; width: 193.26mm; box-sizing: border-box; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body onload="window.print()">
    <table class="outer">
        <colgroup>
            <col style="width:53.85mm" /><col style="width:21.98mm" /><col style="width:14.43mm" />
            <col style="width:12.31mm" /><col style="width:8.73mm" /><col style="width:21.18mm" />
            <col style="width:4.55mm" /><col style="width:24.62mm" /><col style="width:31.61mm" />
        </colgroup>
        <tr style="height:22.35mm">
            <td colspan="3">                
                <div class="agent-name">@V(agentName)</div>
                <span class="agent-cha"><b>C.H.Aagent No. @agentLicenseNo</b></span>
                <div class="agent-addr">@agentAddress</div>
                <div class="agent-phone-gst">
                    <text>Phone : @agentPhone</text>
                    <text>GSTIN @agentGstin</text>
                </div>
            </td>
            <td colspan="6" class="title-cell">
                <div class="copytype">Org/Dup/Trip/Quard/Quin/6th/Office</div>
                <div class="title-body">
                    <div class="formtitle">CUSTOMS TRANSIT DECLARATION<br /><span class="sub subtitle-row">(IMPORT)<span class="iccd">ICCD</span></span></div>
                    <div class="jobno">Job No. <b>@Model.JobNumber</b></div>
                </div>
            </td>
        </tr>
        <tr style="height:18.54mm">
            <td colspan="3" rowspan="2">
                <div class="cell-lbl">Importer's Name &amp; Address</div>
                @if (!string.IsNullOrWhiteSpace(Model.BankName))
                {
                    <div class="cell-val">@Model.BankName</div>
                }
                <div class="cell-val">@V(Model.PartyName)</div>
                @if (!string.IsNullOrWhiteSpace(Model.Address))
                {
                    <div class="cell-val">@Model.Address</div>
                }
            </td>
            <td colspan="6">
                <div class="cell-lbl">Verification</div>
                <div class="verify-text">I have verified that the goods specified In thie Declaration and of the quantity and value spcified herein have been permitted to be Imported by Government of Nepal under Hcence No. and date indicated below :</div>
            </td>
        </tr>
        <tr style="height:6.35mm">
            <td colspan="6">
                <div class="cell-lbl">Country of Consignment <span class="cell-val">@V(Model.CountryCgn)</span></div>
            </td>
        </tr>
        <tr style="height:6.35mm">
            <td rowspan="2">
                <div class="cell-lbl">Notify or delivery address</div>
            </td>
            <td colspan="2" rowspan="2" class="center">
                <div>Same as above</div>
            </td>
            <td colspan="6">
                <div class="cell-lbl">Country of Origin <span class="cell-val">@V(Model.CountryOrigin)</span></div>
            </td>
        </tr>
        <tr style="height:7.41mm">
            <td colspan="6" rowspan="2">
                <div class="cell-lbl">HMO' &amp; Import Licence No. and Date</div>
                @if (!string.IsNullOrWhiteSpace(Model.BankName))
                {
                    <div class="cell-val">@Model.BankName</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.LcNo))
                {
                    <div>LC:<b>@Model.LcNo @(Model.LcDate.HasValue ? "DT." + D(Model.LcDate) : "")</b></div>
                }
            </td>
        </tr>
        <tr style="height:8.47mm">
            <td>
                <div class="cell-lbl">Statement as to transportation</div>
            </td>
            <td colspan="2">
                <div>By Road/Rail</div>
            </td>
        </tr>
        <tr style="height:6.17mm">
            <td colspan="2"><div class="cell-lbl">Ship's Name :</div></td>
            <td colspan="3"><div class="cell-lbl">Rotation No.</div></td>
            <td colspan="2"><div class="cell-lbl">Line No.</div></td>
            <td colspan="2"><div class="cell-lbl">B/L No. &amp; Date.</div></td>
        </tr>
        <tr style="height:9.68mm">
            <td colspan="2">
                <div class="cell-val">@V(shipName)</div>
                @if (!string.IsNullOrWhiteSpace(shipVoyage))
                {
                    <div class="cell-val">@shipVoyage</div>
                }
            </td>
            <td colspan="3"><div class="cell-val">@V(Model.RotNo)</div></td>
            <td colspan="2"><div class="cell-val">@V(Model.LineNo)</div></td>
            <td colspan="2"><div class="cell-val">@V(blNo) @(blDate.HasValue ? "dt." + D(blDate) : "")</div></td>
        </tr>
        <tr style="height:22.98mm">
            <td colspan="3">
                <div class="cell-lbl">Route of Transit:</div>
                <div class="cell-val">@V(Model.RouteOfTransit)</div>
                <div class="intransit">In Transit To Nepal</div>
            </td>
            <td colspan="6">&nbsp;</td>
        </tr>
        <tr style="height:6.63mm" class="cargo-grid">
            <th>Marks and Serial No. of Pkgs</th>
            <th colspan="5">No. and description of Pkgs/description of goods</th>
            <th colspan="2">Gr. Wt. kgs.</th>
            <th>Cif Value Rs.</th>
        </tr>
        <tr style="height:104.97mm">
            <td>
                @if (Model.Containers.Any())
                {
                    @foreach (var c in Model.Containers)
                    {
                        <div class="container-block">
                            @if (!string.IsNullOrWhiteSpace(c.MarksSerial))
                            {
                                <b>@c.MarksSerial</b>
                            }
                            <div>Container</div>
                            <b>@V(c.ContainerNo)@(string.IsNullOrWhiteSpace(c.SealNumbers) ? "" : $"/ {c.SealNumbers}")</b>
                        </div>
                    }
                }
            </td>
            <td colspan="5">
                @foreach (var c in Model.Containers)
                {
                    if (!string.IsNullOrWhiteSpace(c.CustomsCode))
                    {
                        <div><b>@c.CustomsCode</b></div>
                    }
                }
                <div style="margin-top:4px;">
                    @foreach (var c in Model.Containers)
                    {
                        <div>1X<b>@(c.ContainerSize.TrimEnd('t', 'f'))</b>' CONT. STC <b>@c.NoPackages</b> PKG</div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.CargoDescription))
                {
                    <div style="margin-top:4px;font-weight:700;">@Model.CargoDescription</div>
                }
                else if (!string.IsNullOrWhiteSpace(Model.MiscDescription))
                {
                    <div style="margin-top:4px;font-weight:700;">@Model.MiscDescription</div>
                }
                <div style="margin-top:4px;">(AS PER INVOICE)</div>
                <div style="margin-top:8px;">
                    @if (Model.FobValue.HasValue)
                    {
                        <div>FOB <b>@Model.Currency @Model.FobValue.Value.ToString("N2", inr)</b>@if (Model.ExchangeRate.HasValue) {<text>=Rs.<b>@((Model.FobValue.Value * Model.ExchangeRate.Value).ToString("N2", inr))</b>/-</text>}</div>
                    }
                    @if (Model.ExchangeRate.HasValue)
                    {
                        <div>1 @Model.Currency = Rs. <b>@Model.ExchangeRate.Value.ToString("N4", inr)</b></div>
                    }
                    @if (Model.Freight.HasValue)
                    {
                        <div>Freight <b>@Model.Currency :@Model.Freight.Value.ToString("N2", inr)</b>@if (Model.ExchangeRate.HasValue) {<text>=Rs.<b>@((Model.Freight.Value * Model.ExchangeRate.Value).ToString("N2", inr))</b>/-</text>}</div>
                    }
                    @if (Model.InsuranceValueInr.HasValue)
                    {
                        <div>Insurance Rs.<b>@Model.InsuranceValueInr.Value.ToString("N2", inr)</b></div>
                    }
                    @if (Model.CifInr.HasValue)
                    {
                        <div>CIF Value = Rs.<b>@Model.CifInr.Value.ToString("N2", inr)</b>/-</div>
                    }
                </div>
            </td>
            <td colspan="2" class="wv-col">
                <div class="wv-val">@(Model.GrossWeight.HasValue ? Model.GrossWeight.Value.ToString("N3", inr) : "")</div>
                <div class="wv-second">
                    <div class="wv-lbl">Nett. Wt. kgs.</div>
                    <div class="wv-val">@(Model.NetWeight.HasValue ? Model.NetWeight.Value.ToString("N3", inr) : "")</div>
                </div>
            </td>
            <td class="wv-col">
                <div class="wv-val">@Rs(Model.CifInr)</div>
                <div class="wv-second">
                    <div class="wv-lbl">Market Value Rs.</div>
                    <div class="wv-val">@Rs(Model.MarketValueInr)</div>
                </div>
            </td>
        </tr>
        <tr style="height:31.75mm">
            <td colspan="4">
                <div class="cell-lbl">Endorsement by Customs House on entry</div>
            </td>
            <td colspan="5" rowspan="2" class="decl-cell" style="position:relative;">
                <div style="margin-bottom:2px;">Declaration,</div>
                <div>'I/We declare that the goods entered herein are for Nepal in transit through India and shall not be diverted enroute or retained in India'..</div>
                <div>'I/We declare that the entires made herein above are true and correct to the best of my/our knowledge and. belief.</div>
                <div class="sign-block">
                    For <b>@V(agentName)</b>
                </div>
                <div class="sign-date">
                    Date <b>@D(Model.CtdDate ?? DateTime.Today)</b> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Director / Authorised SIgnatory
                </div>
            </td>
        </tr>
        <tr style="height:26.28mm">
            <td colspan="4">
                <div class="cell-lbl">Endorsement by Indian Border Customs Office on Exit</div>
            </td>
        </tr>
    </table>

    <p class="footer">Printed from Eroyal Suite &middot; @DateTime.Now.ToString("g")</p>
</body>
</html>
